# Use the actual site origin behind your reverse proxy.
LAB_ORIGIN=https://lululab.site
# Set a unique random passphrase of at least 16 characters to enable the lock.
LAB_WORKBENCH_PASSPHRASE=
# Optional trusted HTTPS origins for embedding external admin pages, comma separated.
LAB_WORKBENCH_FRAME_ORIGINS=
# Optional GitHub API token for public repository popularity search.
LAB_GITHUB_TOKEN=
# In production, use a persistent private directory writable by the service user.
LAB_DATA_DIR=.lab-data
HOST=127.0.0.1
PORT=4178
# Optional host-only port for Docker Compose. The container always uses 4178.
# LULULAB_BIND_PORT=4178
# Optional deployment-specific Docker image sources.
# LULULAB_NODE_IMAGE=node:22-bookworm-slim
# LULULAB_CADDY_IMAGE=caddy:2-alpine
# Limited title/summary reader for personal, non-commercial use. Set false to hide live data.
# The code's MIT license does not license aihot.news operating data; follow the upstream service terms.
AIHOT_ENABLED=true
# Change this origin to read from your own AIHOT engine deployment.
AIHOT_BASE_URL=https://aihot.news
AIHOT_SOURCE_NAME=AIHOT
